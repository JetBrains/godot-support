# `include()`d module segments do not inherit symbols defined in the root MODULE.bazel,
# so the repo rule is declared locally.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

rd_cpp_repository = use_repo_rule(
    "//dotnet/Plugins/godot-support/godot-rd:rd_cpp_repository.bzl",
    "rd_cpp_repository",
)

rd_cpp_repository(
    name = "rd_cpp",
    build_file = "@//dotnet/Plugins/godot-support/godot-rd:BUILD.rd_cpp",
)

http_archive(
    name = "godot_cpp",
    build_file = "@//dotnet/Plugins/godot-support/godot-rd:BUILD.godot_cpp",
    sha256 = "c763a08b8ec18dae300cd54bb8848faf1a5fd11da629449d16649a72a1884727",
    strip_prefix = "godot-cpp-10.0.0-stable",
    url = "https://github.com/godotengine/godot-cpp/archive/refs/tags/10.0.0-stable.zip",
)
